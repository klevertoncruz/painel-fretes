rules_version = '2';

// Só quem tem login lê os dados. Só os e-mails listados em config/admins
// (campo "emails", do tipo array) podem importar planilha e registrar correções.
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() {
      return request.auth != null;
    }
    function admin() {
      return logado()
        && request.auth.token.email in get(/databases/$(db)/documents/config/admins).data.emails;
    }

    match /config/{doc} {
      allow read: if logado();
      allow write: if false;
    }
    match /base/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
    match /base_partes/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
    match /correcoes/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
    match /justificativas/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
    match /fechamentos/{doc} {
      allow read: if logado();
      allow write: if admin();
    }
  }
}
